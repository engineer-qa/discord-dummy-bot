DISCORD_TOKEN=вставь_токен_бота
ANTHROPIC_API_KEY=sk-ant-...
MODEL=claude-haiku-4-5
# нужен, только если API ключ не привязан к workspace (ошибка про anthropic-workspace-id)
ANTHROPIC_WORKSPACE_ID=

# необязательные настройки
HISTORY_LEN=30
INTERJECT_CHANCE=0.03
INTERJECT_COOLDOWN=600
USER_LIMIT_PER_HOUR=30
# ID каналов через запятую; пусто = все каналы, где бот есть
ALLOWED_CHANNELS=
