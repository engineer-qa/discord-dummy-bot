DISCORD_TOKEN=вставь_токен_бота
ANTHROPIC_API_KEY=sk-ant-...
MODEL=claude-haiku-4-5
# нужен, только если API ключ не привязан к workspace (ошибка про anthropic-workspace-id)
ANTHROPIC_WORKSPACE_ID=

# необязательные настройки
# контекст: сообщения старше FRESH_MINUTES не показываются, максимум MAX_CONTEXT штук
FRESH_MINUTES=20
MAX_CONTEXT=15
# шанс влезть в живой разговор без тега и пауза между такими влезаниями (сек)
INTERJECT_CHANCE=0.3
INTERJECT_COOLDOWN=60
USER_LIMIT_PER_HOUR=30
# ID каналов через запятую; пусто = все каналы, где бот есть
ALLOWED_CHANNELS=
# папка для памяти; на Railway — путь к volume, например /app/data
DATA_DIR=
# жёсткий лимит длины ответа в символах (страховка от простыней)
MAX_CHARS_INTERJECT=120
MAX_CHARS_DIRECT=220
